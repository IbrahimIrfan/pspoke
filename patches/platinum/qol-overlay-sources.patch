+/* PSP QoL (2026-09-13): Repel re-use prompt (later games / Renegade Platinum behaviour).
+   When the step counter reaches 0 and the bag holds another Repel of the kind last used
+   (any kind if unknown, e.g. after loading a save mid-Repel), a native field task shows
+   "Repel's effect wore off...\nUse another?" with a Yes/No menu. YES removes one from the
+   bag, restarts the step counter with the item's step count and prints the bag's
+   "<player> used the <item>." message. Without a Repel in the bag the original ROM
+   script (common script 32) runs unchanged. Field scripts in the ROM are not modified. */
+
+extern u16 gPSPQoLLastRepel;
+
+enum RepelPromptState {
+    REPEL_PROMPT_INIT = 0,
+    REPEL_PROMPT_WAIT_ASK,
+    REPEL_PROMPT_YES_NO,
+    REPEL_PROMPT_WAIT_USED,
+    REPEL_PROMPT_WAIT_BUTTON,
+    REPEL_PROMPT_CLOSE,
+};
+
+typedef struct RepelPrompt {
+    u8 state;
+    u8 printerID;
+    u16 item;
+    Window *window;
+    Menu *menu;
+    String *msg;
+} RepelPrompt;
+
+static const WindowTemplate sRepelYesNoWindowTemplate = {
+    .bgLayer = BG_LAYER_MAIN_3,
+    .tilemapLeft = 25,
+    .tilemapTop = 13,
+    .width = 6,
+    .height = 4,
+    .palette = FIELD_MESSAGE_PALETTE_INDEX,
+    .baseTile = 0x21F,
+};
+
+/* "Use another?" in the DS character map, preceded by a line break. */
+static const charcode_t sUseAnother[] = { 0xE000, 0x013F, 0x0157, 0x0149, 0x01DE, 0x0145, 0x0152, 0x0153, 0x0158, 0x014C, 0x0149, 0x0156, 0x01AC };
+
+static BOOL IsRepel(u16 item)
+{
+    return item == ITEM_REPEL || item == ITEM_SUPER_REPEL || item == ITEM_MAX_REPEL;
+}
+
+static u16 FindRepelToReuse(Bag *bag)
+{
+    if (IsRepel(gPSPQoLLastRepel)) {
+        return Bag_CanRemoveItem(bag, gPSPQoLLastRepel, 1, HEAP_ID_FIELD2) ? gPSPQoLLastRepel : ITEM_NONE;
+    }
+
+    static const u16 order[] = { ITEM_REPEL, ITEM_SUPER_REPEL, ITEM_MAX_REPEL };
+
+    for (int i = 0; i < 3; i++) {
+        if (Bag_CanRemoveItem(bag, order[i], 1, HEAP_ID_FIELD2)) {
+            return order[i];
+        }
+    }
+
+    return ITEM_NONE;
+}
+
+static void RepelPrompt_Print(FieldSystem *fieldSystem, RepelPrompt *prompt)
+{
+    Window_FillTilemap(prompt->window, 15);
+    prompt->printerID = FieldMessage_Print(prompt->window, prompt->msg, SaveData_GetOptions(fieldSystem->saveData), TRUE);
+}
+
+static BOOL FieldTask_RepelPrompt(FieldTask *task)
+{
+    FieldSystem *fieldSystem = FieldTask_GetFieldSystem(task);
+    RepelPrompt *prompt = FieldTask_GetEnv(task);
+
+    switch (prompt->state) {
+    case REPEL_PROMPT_INIT: {
+        MapObjectMan_PauseAllMovement(fieldSystem->mapObjMan);
+
+        prompt->window = Window_New(HEAP_ID_FIELD2, 1);
+        Window_Init(prompt->window);
+        FieldMessage_AddWindow(fieldSystem->bgConfig, prompt->window, BG_LAYER_MAIN_3);
+        FieldMessage_DrawWindow(prompt->window, SaveData_GetOptions(fieldSystem->saveData));
+
+        MessageLoader *loader = MessageLoader_Init(MSG_LOADER_LOAD_ON_DEMAND, NARC_INDEX_MSGDATA__PL_MSG, TEXT_BANK_COMMON_STRINGS, HEAP_ID_FIELD2);
+        String *woreOff = MessageLoader_GetNewString(loader, CommonStrings_Text_RepelsEffectWoreOff);
+        const charcode_t *src = String_GetData(woreOff);
+        charcode_t buf[160];
+        int n = 0;
+
+        while (n < 140 && src[n] != 0xFFFF /* EOS */) {
+            buf[n] = src[n];
+            n++;
+        }
+
+        for (int i = 0; i < (int)(sizeof(sUseAnother) / sizeof(sUseAnother[0])); i++) {
+            buf[n++] = sUseAnother[i];
+        }
+
+        buf[n] = 0xFFFF /* EOS */;
+        prompt->msg = String_Init(160, HEAP_ID_FIELD2);
+        String_CopyChars(prompt->msg, buf);
+        String_Free(woreOff);
+        MessageLoader_Free(loader);
+
+        RepelPrompt_Print(fieldSystem, prompt);
+        prompt->state = REPEL_PROMPT_WAIT_ASK;
+    } break;
+
+    case REPEL_PROMPT_WAIT_ASK:
+        /* Wait for the d-pad to be released: the prompt appears mid-walk and a held
+           direction would otherwise move the cursor straight to NO. */
+        if (FieldMessage_FinishedPrinting(prompt->printerID) && JOY_HELD(PAD_KEY_UP | PAD_KEY_DOWN | PAD_KEY_LEFT | PAD_KEY_RIGHT) == 0) {
+            LoadStandardWindowGraphics(fieldSystem->bgConfig, BG_LAYER_MAIN_3, 1024 - (18 + 12) - 9, 11, STANDARD_WINDOW_SYSTEM, HEAP_ID_FIELD1);
+            prompt->menu = Menu_MakeYesNoChoice(fieldSystem->bgConfig, &sRepelYesNoWindowTemplate, 1024 - (18 + 12) - 9, 11, HEAP_ID_FIELD1);
+            prompt->state = REPEL_PROMPT_YES_NO;
+        }
+        break;
+
+    case REPEL_PROMPT_YES_NO: {
+#ifdef SDK_BUILD_ARM
+        u32 result = Menu_ProcessInputAndHandleExit(prompt->menu, HEAP_ID_FIELD1);
+#else
+        u64 result = Menu_ProcessInputAndHandleExit(prompt->menu, HEAP_ID_FIELD1);
+#endif
+
+        if (result == MENU_NOTHING_CHOSEN) {
+            break;
+        }
+
+        prompt->menu = NULL;
+
+        if (result != MENU_YES) {
+            prompt->state = REPEL_PROMPT_CLOSE;
+            break;
+        }
+
+        Bag *bag = SaveData_GetBag(fieldSystem->saveData);
+
+        if (!Bag_TryRemoveItem(bag, prompt->item, 1, HEAP_ID_FIELD2)) {
+            prompt->state = REPEL_PROMPT_CLOSE;
+            break;
+        }
+
+        u8 *repelSteps = SpecialEncounter_GetRepelSteps(SaveData_GetSpecialEncounters(fieldSystem->saveData));
+        *repelSteps = Item_LoadParam(prompt->item, ITEM_PARAM_EFFECT_PARAM, HEAP_ID_FIELD2);
+        gPSPQoLLastRepel = prompt->item;
+        Sound_PlayEffect(SEQ_SE_DP_CARD2_sseq);
+
+        MessageLoader *loader = MessageLoader_Init(MSG_LOADER_LOAD_ON_DEMAND, NARC_INDEX_MSGDATA__PL_MSG, TEXT_BANK_BAG, HEAP_ID_FIELD2);
+        String *fmt = MessageLoader_GetNewString(loader, Bag_Text_UsedRepel);
+        StringTemplate *template = StringTemplate_Default(HEAP_ID_FIELD2);
+
+        StringTemplate_SetPlayerName(template, 0, SaveData_GetTrainerInfo(fieldSystem->saveData));
+        StringTemplate_SetItemName(template, 1, prompt->item);
+        StringTemplate_Format(template, prompt->msg, fmt);
+        StringTemplate_Free(template);
+        String_Free(fmt);
+        MessageLoader_Free(loader);
+
+        RepelPrompt_Print(fieldSystem, prompt);
+        prompt->state = REPEL_PROMPT_WAIT_USED;
+    } break;
+
+    case REPEL_PROMPT_WAIT_USED:
+        if (FieldMessage_FinishedPrinting(prompt->printerID)) {
+            prompt->state = REPEL_PROMPT_WAIT_BUTTON;
+        }
+        break;
+
+    case REPEL_PROMPT_WAIT_BUTTON:
+        if (JOY_NEW(PAD_BUTTON_A | PAD_BUTTON_B)) {
+            prompt->state = REPEL_PROMPT_CLOSE;
+        }
+        break;
+
+    case REPEL_PROMPT_CLOSE:
+        Window_EraseMessageBox(prompt->window, FALSE);
+        Window_Remove(prompt->window);
+        Heap_Free(prompt->window);
+        String_Free(prompt->msg);
+        MapObjectMan_UnpauseAllMovement(fieldSystem->mapObjMan);
+        Heap_Free(prompt);
+        return TRUE;
+    }
+
+    return FALSE;
+}
